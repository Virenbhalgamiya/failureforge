# FailureForge Environment Configuration
# Copy this file to .env before running

# Optional: Groq / OpenAI compatible LLM API Key
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_MODEL=groq/compound-mini

# Database (defaults to SQLite in current directory)
DATABASE_URL=sqlite+aiosqlite:///./failureforge.db
DATABASE_URL_SYNC=sqlite:///./failureforge.db

# Application Configuration
APP_NAME=FailureForge
DEBUG=false
LOG_LEVEL=INFO
DEMO_MODE=true
